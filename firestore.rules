rules_version = '2';

// Reglas de seguridad de Cloud Firestore (proyecto mis15-5aee3).
// PÉGALAS EN: Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rsvp/{phoneId} {
      // Cualquier visitante puede registrar UNA confirmación por teléfono.
      // El ID del documento es el teléfono (solo dígitos). Al no existir
      // permiso de actualización, un segundo envío con el mismo teléfono
      // se rechaza con "permission-denied" y el cliente lo interpreta
      // como duplicado.
      allow create: if isValidRsvp(request.resource.data)
                    && phoneId == request.resource.data.telefonoId;

      // Solo la cuenta administradora autenticada puede leer o modificar.
      allow read, update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jauja.ariana@gmail.com';
    }

    // Validación de integridad: evita datos basura insertados a mano.
    function isValidRsvp(d) {
      return d.keys().hasOnly([
          'nombreCompleto', 'telefono', 'telefonoId',
          'modalidad', 'acompanante', 'totalPersonas', 'creadoEn'
        ])
        && d.nombreCompleto is string
        && d.nombreCompleto.size() >= 3 && d.nombreCompleto.size() <= 80
        && d.telefono is string
        && d.telefono.size() >= 7 && d.telefono.size() <= 25
        && d.telefonoId is string
        && d.telefonoId.size() >= 7 && d.telefonoId.size() <= 15
        && d.modalidad in ['si', 'no']
        && d.totalPersonas is int
        && (
          (d.modalidad == 'si' && d.totalPersonas == 1 && d.acompanante == null)
          || (d.modalidad == 'no' && d.totalPersonas == 0 && d.acompanante == null)
        );
    }
  }
}
